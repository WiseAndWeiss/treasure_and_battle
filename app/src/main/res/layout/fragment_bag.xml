<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_screen_treasure">

    <!-- ====================== 1. 装备区（9个槽位，严格按RPG标准布局） ====================== -->

    <!-- ====================== 2. 分页控制区（纯页码翻页，无任何分类） ====================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_treasure"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 装备槽位布局：左右对称，9个槽位 -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="装备栏"
            android:textColor="@color/tb_gold"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <!-- 左侧：护甲槽（头盔、胸甲、护腿、鞋子） -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/slot_helmet"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_slot_treasure"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="头盔"
                        android:textColor="@color/tb_text_main"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/slot_chest"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_slot_treasure"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="胸甲"
                        android:textColor="@color/tb_text_main"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/slot_leggings"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_slot_treasure"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="护腿"
                        android:textColor="@color/tb_text_main"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/slot_boots"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_slot_treasure"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="鞋子"
                        android:textColor="@color/tb_text_main"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- 中间：武器槽 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/slot_weapon"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_slot_treasure"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="武器"
                        android:textColor="@color/tb_text_main"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- 右侧：饰品槽（项链、手镯、左戒指、右戒指） -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/slot_necklace"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_slot_treasure"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="项链"
                        android:textColor="@color/tb_text_main"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/slot_bracelet"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_slot_treasure"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="手镯"
                        android:textColor="@color/tb_text_main"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/slot_ring_left"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_slot_treasure"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="左戒"
                        android:textColor="@color/tb_text_main"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/slot_ring_right"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_slot_treasure"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="右戒"
                        android:textColor="@color/tb_text_main"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_panel_treasure"
        android:elevation="2dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btn_compact_bag"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_tab_idle"
            android:text="整理"
            android:textColor="@color/tb_text_main"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_prev_page"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="◀"
                android:textColor="@color/tb_gold_deep"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tv_page_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="第1页 / 共5页"
                android:textColor="@color/tb_text_main"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_filter_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:text="当前筛选：全部"
                android:textColor="@color/tb_text_sub"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_next_page"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="▶"
                android:textColor="@color/tb_gold_deep"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btn_filter_slot"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_tab_idle"
            android:text="筛选"
            android:textColor="@color/tb_text_main"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

    </RelativeLayout>

    <!-- ====================== 3. 背包格子区（每页5x5=25格，无滚动） ====================== -->
    <LinearLayout
        android:id="@+id/grid_bag_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_panel_treasure"
        android:padding="8dp"
        android:elevation="2dp"
        android:orientation="vertical"/>

</LinearLayout>