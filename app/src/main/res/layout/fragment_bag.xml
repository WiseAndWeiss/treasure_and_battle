<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/bg_screen_treasure">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panel_bag_equipment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_treasure"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="2dp"
        android:padding="8dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_tachie_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.28" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_tachie_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.72" />

        <LinearLayout
            android:id="@+id/container_left_armors"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guide_tachie_left"
            app:layout_constraintTop_toTopOf="@id/cv_tachie"
            app:layout_constraintBottom_toBottomOf="@id/slot_weapon">

            <LinearLayout
                android:id="@+id/slot_helmet"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_slot_treasure"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="头盔" android:textColor="@color/tb_text_main" android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/slot_chest"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_slot_treasure"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="胸甲" android:textColor="@color/tb_text_main" android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/slot_leggings"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_slot_treasure"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="护腿" android:textColor="@color/tb_text_main" android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/slot_boots"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_slot_treasure"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="鞋子" android:textColor="@color/tb_text_main" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/container_right_accessories"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="@id/guide_tachie_right"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cv_tachie"
            app:layout_constraintBottom_toBottomOf="@id/slot_weapon">

            <LinearLayout
                android:id="@+id/slot_necklace"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_slot_treasure"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="项链" android:textColor="@color/tb_text_main" android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/slot_bracelet"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_slot_treasure"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="手镯" android:textColor="@color/tb_text_main" android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/slot_ring_left"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_slot_treasure"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="左戒" android:textColor="@color/tb_text_main" android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/slot_ring_right"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_slot_treasure"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="右戒" android:textColor="@color/tb_text_main" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_tachie"
            android:layout_width="0dp"
            android:layout_height="192dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:layout_constraintStart_toStartOf="@id/guide_tachie_left"
            app:layout_constraintEnd_toStartOf="@id/guide_tachie_right"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/iv_tachie"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/item_detail_close" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/layout_tachie_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/cv_tachie"
            app:layout_constraintStart_toStartOf="@id/cv_tachie"
            app:layout_constraintEnd_toEndOf="@id/cv_tachie">

            <TextView
                android:id="@+id/tv_tachie_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="冒险者"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_tachie_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lv.1"
                android:textColor="#FFFFD54F"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/pb_tachie_exp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/tb_gold" />

                <TextView
                    android:id="@+id/tv_tachie_exp_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="0/100"
                    android:textColor="@color/tb_battle"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_weapon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_slot_treasure"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/layout_tachie_info"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="武器" android:textColor="@color/tb_text_main" android:textSize="13sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        layout="@layout/include_bag_bottom_half"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>