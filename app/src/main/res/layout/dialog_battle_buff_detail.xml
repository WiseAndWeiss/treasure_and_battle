<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel_treasure_fill_only"
    android:foreground="@drawable/bg_panel_treasure_stroke_only"
    android:orientation="vertical"
    android:padding="13dp">

    <TextView
        android:id="@+id/tv_battle_buff_detail_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/tb_gold"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_battle_buff_detail_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/tb_text_main"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btn_battle_buff_detail_ok"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_tab_active"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="知道了"
        android:textColor="@color/tb_bg_dark"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
