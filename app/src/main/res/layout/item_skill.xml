<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="92dp"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_panel_treasure_fill_only"
    android:foreground="@drawable/bg_panel_treasure_stroke_only">

    <!-- 技能图标 -->
    <ImageView
        android:id="@+id/iv_skill_icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@android:drawable/ic_menu_gallery"
        android:background="@drawable/bg_slot_treasure_fill"
        android:foreground="@drawable/bg_slot_treasure_stroke"
        android:layout_marginEnd="12dp"/>

    <!-- 技能文字标题与描述 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        
        <TextView
            android:id="@+id/tv_skill_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="技能名"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="@color/tb_text_main"/>
            
        <TextView
            android:id="@+id/tv_skill_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="技能效果描述"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/tb_text_sub"/>
            
    </LinearLayout>

    <!-- 技能等级 -->
    <TextView
        android:id="@+id/tv_skill_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1/5"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/tb_gold"
        android:layout_marginEnd="12dp" />

    <!-- 加号 / 行动交互按钮 -->
    <ImageView
        android:id="@+id/btn_skill_action"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/upgrade_2"
        android:padding="6dp"
        android:background="@drawable/bg_slot_treasure_fill"
        android:foreground="@drawable/bg_slot_treasure_stroke"/>

</LinearLayout>