<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel_treasure_fill_only"
    android:foreground="@drawable/bg_panel_treasure_stroke_only"
    android:orientation="vertical"
    android:paddingStart="11dp"
    android:paddingTop="15dp"
    android:paddingEnd="11dp"
    android:paddingBottom="11dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:text="战斗记录"
        android:textColor="@color/tb_gold"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="由上至下：最新 → 较早"
        android:textColor="@color/tb_text_sub"
        android:textSize="11sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_battle_log"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingBottom="4dp"
        android:scrollbars="vertical" />
</LinearLayout>
