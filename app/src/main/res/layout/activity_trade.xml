<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F0F0">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:elevation="2dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="商店"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="返回"
            android:textSize="14sp"
            android:textColor="#2196F3"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Tab 切换栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_sell"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="出售"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FF9800"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tab_buy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="购买"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#888888"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <View
            android:id="@+id/tab_indicator"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:background="#FF9800" />
    </LinearLayout>

    <!-- 预留图片展示区域 -->
    <LinearLayout
        android:id="@+id/shop_image_area"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#E8E8E8"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="商品展示图（待添加）"
            android:textSize="14sp"
            android:textColor="#999999" />
    </LinearLayout>

    <!-- 物品栏标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tv_item_list_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="我的物品"
            android:textSize="14sp"
            android:textColor="#555555" />

        <TextView
            android:id="@+id/tv_page_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="第1页 / 共1页"
            android:textSize="12sp"
            android:textColor="#999999" />
    </LinearLayout>

    <!-- 物品格子区 -->
    <LinearLayout
        android:id="@+id/grid_shop_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:orientation="vertical" />
</LinearLayout>
