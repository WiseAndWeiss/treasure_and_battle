<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_treasure"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_battle_back"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_tab_idle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="返回"
            android:textColor="@color/tb_text_main"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="战斗（演示）"
            android:textColor="@color/tb_gold"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="56dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/monster_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1.5"
        android:background="@drawable/bg_panel_treasure"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 恢复 center_vertical，让怪物整体居中分布，上下都有内容 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical"
            android:paddingTop="0dp"
            android:paddingBottom="20dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:layout_marginTop="-12dp"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/battle_slot_0"
                    layout="@layout/item_battle_monster_slot" />

                <include
                    android:id="@+id/battle_slot_1"
                    layout="@layout/item_battle_monster_slot" />
            </LinearLayout>

            <include
                android:id="@+id/battle_slot_2"
                layout="@layout/item_battle_monster_slot"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="-12dp"
                android:clipChildren="false"
                android:clipToPadding="false">
                <include android:id="@+id/battle_slot_3" layout="@layout/item_battle_monster_slot" />
                <include android:id="@+id/battle_slot_4" layout="@layout/item_battle_monster_slot" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_battle_log_book"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/battle_log_book_cd"
            android:focusable="true"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_battle_log_book" />

        <TextView
            android:id="@+id/btn_battle_cancel"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_tab_idle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="取消"
            android:textColor="@color/tb_text_sub"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_battle_confirm"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_tab_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="确定"
            android:textColor="@color/tb_bg_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/panel_left_ops"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_treasure"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/btn_battle_attack"
                style="@style/TbBattleCommand"
                android:text="攻击" />
            <TextView
                android:id="@+id/btn_battle_skill"
                style="@style/TbBattleCommand"
                android:layout_marginTop="6dp"
                android:text="技能" />
            <TextView
                android:id="@+id/btn_battle_item"
                style="@style/TbBattleCommand"
                android:layout_marginTop="6dp"
                android:text="道具" />
            <TextView
                android:id="@+id/btn_battle_escape"
                style="@style/TbBattleCommand"
                android:layout_marginTop="6dp"
                android:text="逃跑" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/panel_center"
            android:layout_width="128dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_battle_tachie"
                android:layout_width="128dp"
                android:layout_height="192dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/iv_battle_tachie"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="@string/item_detail_close"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    tools:srcCompat="@tools:sample/avatars[6]" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/btn_end_turn"
                android:layout_width="120dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_tab_active"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="结束回合"
                android:textColor="@color/tb_bg_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/panel_status_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp"
                app:layout_constraintBottom_toTopOf="@id/btn_end_turn"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_battle_player_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="冒险者" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="生命"
                        android:textColor="@color/tb_text_sub"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/tv_battle_player_hp_val"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/tb_text_main"
                        android:textSize="10sp"
                        tools:text="80 / 100" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_battle_player_hp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="2dp"
                    android:max="100"
                    android:progress="80"
                    android:progressTint="@color/tb_battle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="法力"
                        android:textColor="@color/tb_text_sub"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/tv_battle_player_mp_val"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/tb_text_main"
                        android:textSize="10sp"
                        tools:text="40 / 50" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_battle_player_mp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="2dp"
                    android:max="100"
                    android:progress="60"
                    android:progressTint="#FF3949AB" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="行动点"
                        android:textColor="@color/tb_text_sub"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/tv_battle_player_ap_val"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/tb_text_main"
                        android:textSize="10sp"
                        tools:text="2 / 2" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_battle_player_ap"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="2dp"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="@color/tb_gold" />

                <TextView
                    android:id="@+id/tv_battle_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:minLines="2"
                    android:textColor="@color/tb_text_sub"
                    android:textSize="10sp"
                    tools:text="提示" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/panel_right_buffs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_treasure"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="状态"
                android:textColor="@color/tb_gold"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_battle_buffs"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="4dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>