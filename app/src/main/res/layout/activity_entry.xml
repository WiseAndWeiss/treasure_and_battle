<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_treasure_fill_only">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="treasure and battle"
            android:textSize="36sp"
            android:textColor="@color/tb_text_main"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.15"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_game"
            android:textSize="16sp"
            android:textColor="@color/tb_text_sub"
            android:gravity="center"
            android:layout_marginBottom="48dp" />

        <Button
            android:id="@+id/btn_start_game"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_start_game"
            android:textSize="18sp"
            android:textColor="@color/tb_panel"
            android:textStyle="bold"
            android:background="@drawable/bg_entry_primary_btn"
            android:layout_marginBottom="16dp"
            android:elevation="4dp" />

        <Button
            android:id="@+id/btn_select_save"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_select_save"
            android:textSize="18sp"
            android:textColor="@color/tb_text_main"
            android:textStyle="bold"
            android:background="@drawable/bg_entry_secondary_btn"
            android:layout_marginBottom="16dp"
            android:elevation="4dp" />

        <Button
            android:id="@+id/btn_encyclopedia"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_book"
            android:textSize="18sp"
            android:textColor="@color/tb_text_main"
            android:textStyle="bold"
            android:background="@drawable/bg_entry_secondary_btn"
            android:elevation="4dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
