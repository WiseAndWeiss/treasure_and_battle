<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tab_idle"
    android:orientation="vertical"
    android:padding="10dp"
    android:layout_margin="4dp"
    android:minHeight="80dp"
    android:gravity="center">

    <TextView
        android:id="@+id/tv_slot_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/tb_gold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tv_slot_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textColor="@color/tb_text_main"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tv_slot_exp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/tb_text_sub"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tv_slot_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="10sp"
        android:textColor="@color/tb_text_sub"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
