<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_screen_treasure">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设置"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/tb_gold"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_panel_treasure"
        android:padding="14dp">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_show_map_poi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="显示地图自带地名/建筑图标"
            android:textColor="@color/tb_text_main"
            android:textSize="16sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:thumbTint="@color/tb_switch_thumb"
            app:trackTint="@color/tb_switch_track"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="关闭后地图将更干净，避免与游戏事件图标重叠。"
            android:textSize="12sp"
            android:textColor="@color/tb_text_sub"
            android:lineSpacingExtra="2dp"/>

        <TextView
            android:id="@+id/btn_open_trade"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tab_idle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="交易（临时入口）"
            android:textColor="@color/tb_text_main"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_open_battle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_tab_idle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="战斗界面（演示）"
            android:textColor="@color/tb_text_main"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>