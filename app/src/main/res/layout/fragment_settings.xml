<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_screen_treasure">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设置"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/tb_gold"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_panel_treasure"
        android:padding="14dp">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_show_map_poi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="显示地图自带地名/建筑图标"
            android:textColor="@color/tb_text_main"
            android:textSize="16sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:thumbTint="@color/tb_switch_thumb"
            app:trackTint="@color/tb_switch_track"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="关闭后地图将更干净，避免与游戏事件图标重叠。"
            android:textSize="12sp"
            android:textColor="@color/tb_text_sub"
            android:lineSpacingExtra="2dp"/>

        <TextView
            android:id="@+id/btn_open_trade"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tab_idle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="交易（临时入口）"
            android:textColor="@color/tb_text_main"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_open_battle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_tab_idle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="战斗界面（演示）"
            android:textColor="@color/tb_text_main"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_back_to_main"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_tab_idle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="返回主页面"
            android:textColor="@color/tb_text_main"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginVertical="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="开发者选项"
        android:textSize="16sp"
        android:textColor="#888888"
        android:layout_marginBottom="8dp"/>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_debug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="调试功能"
        android:textSize="16sp"
        android:padding="10dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="开启后地图页面将出现/调试功能/按钮，可在当前位置生成测试事件。"
        android:textSize="12sp"
        android:textColor="#888888"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_panel_treasure"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/btn_debug_gain_exp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="8dp"
            android:text="+500000经验"
            android:textColor="@color/tb_battle"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_debug_gain_talent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="8dp"
            android:text="+20天赋点"
            android:textColor="@color/tb_battle"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_debug_gain_skill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="8dp"
            android:text="+20技能点"
            android:textColor="@color/tb_battle"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_debug_setup_test_character"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_panel_treasure"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="12dp"
        android:text="🧪 设置测试角色"
        android:textColor="@color/tb_battle"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="血量1000/防御50/技能1级"
        android:textSize="11sp"
        android:textColor="#888888"
        android:gravity="center"
        android:layout_marginTop="2dp"/>

</LinearLayout>
