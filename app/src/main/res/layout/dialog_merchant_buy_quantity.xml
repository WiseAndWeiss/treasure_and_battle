<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tv_buy_item_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/tb_text_main"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_buy_unit_and_stock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/tb_text_sub"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="数量"
            android:textColor="@color/tb_text_main"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_qty_minus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tab_idle"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/tb_text_main"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tv_buy_quantity"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/tb_gold_deep"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_qty_plus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tab_idle"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/tb_text_main"
            android:textSize="22sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_buy_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/tb_gold"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
