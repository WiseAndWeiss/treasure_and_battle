*.jks
*.keystore
*.properties

# vscode
.vscode/

# ------------------
# Claude Code generated English markdown files
# ------------------
# Ignore English .md files generated by Claude Code (but keep important Chinese docs)
app/doc/
[A-Za-z_]*.md
app/ANIMATION_*.md
app/*_SYSTEM_*.md
app/*_FIX.md
app/*_GUIDE.md
app/TEST_*.md
app/*_INTEGRATION.md
app/*_SUMMARY.md
app/doc/ARCHITECTURE_*.md
app/doc/COMPLETE_GAME_FLOW_*.md
app/doc/MIDDLE_TERM_*.md
src/test/**/*Summary.md
src/test/**/*_FIX_SUMMARY.md
src/test/**/*_PROGRESS.md
src/test/**/*TestSummary.md
src/test/**/*Test*.md

# Ignore all text files and backup files
*.txt
*.bak
*.java.bak
